# Copie para .env.local e preencha. Variáveis com prefixo VITE_ vão para o
# bundle do front, portanto só coloque aqui valores públicos.

# URL e publishable key (sb_publishable_..., antiga "anon key") do projeto
# Supabase. São públicas por design; a proteção dos dados vem do RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# A chave do Gemini NÃO entra aqui. Ela fica só nos secrets do Supabase:
#   supabase secrets set GEMINI_API_KEY=...

# Para o `npm run dev` usar o Supabase local (npx supabase start), crie um
# .env.development.local com os valores do `npx supabase status`. Ele tem
# prioridade sobre o .env.local só no modo dev; o build continua no remoto.
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Login local (criado pelo seed): casa@local.test / senha-local
