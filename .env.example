# Copie para .env.local e preencha. Variáveis com prefixo VITE_ vão para o
# bundle do front, portanto só coloque aqui valores públicos.

# URL e publishable key (sb_publishable_..., antiga "anon key") do projeto
# Supabase. São públicas por design; a proteção dos dados vem do RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# A chave do Gemini NÃO entra aqui. Ela fica só nos secrets do Supabase:
#   supabase secrets set GEMINI_API_KEY=...
